module vector-r (*)

import vector
import root-r

-- Vector shares its wire form with List; in R, both are R atomic vectors
-- (the runtime form chosen depends on the element type at unpack time).
type R => ( Vector (n :: Nat) Bool    ) = "logical"   n Bool
type R => ( Vector (n :: Nat) Str     ) = "character" n Str
type R => ( Vector (n :: Nat) Int     ) = "numeric"   n Int
type R => ( Vector (n :: Nat) I64   ) = "numeric"   n I64
type R => ( Vector (n :: Nat) I32   ) = "integer"   n I32
type R => ( Vector (n :: Nat) I16   ) = "integer"   n I16
type R => ( Vector (n :: Nat) I8    ) = "integer"   n I8
type R => ( Vector (n :: Nat) U64  ) = "numeric"   n U64
type R => ( Vector (n :: Nat) U32  ) = "numeric"   n U32
type R => ( Vector (n :: Nat) U16  ) = "integer"   n U16
type R => ( Vector (n :: Nat) Real    ) = "numeric"   n Real
type R => ( Vector (n :: Nat) F64 ) = "numeric"   n F64
type R => ( Vector (n :: Nat) F32 ) = "numeric"   n F32
type R => ( Vector (n :: Nat) U8   ) = "raw"       n U8
type R => ( Vector (n :: Nat) a       ) = "list"      n a

source R from "R/vector.R"
    ( "morloc_zeros1" as zeros1
    , "morloc_ones1"  as ones1
    , "morloc_fill1"  as fill1
    )

-- Typeclass-method backends for Vector. @morloc_vec_*@ in R/vector.R
-- operate on R atomic vectors directly (c(), vapply, Reduce).

instance SemigroupDim Vector where
  %inline source R from "R/vector.R" ("morloc_vec_concat" as (++))

instance MonoidDim Vector where
  empty0 = []

instance Indexable (Vector n) where
  %inline source R from "R/vector.R" ("morloc_vec_at" as __access_index__)

instance SliceableDim Vector where
  %inline source R from "R/vector.R" ("morloc_vec_slice" as __get_slice_dim__)

instance Functor (Vector n) where
  %inline source R from "R/vector.R" ("morloc_vec_map" as map)

instance Foldable (Vector n) where
  %inline source R from "R/vector.R"
    ( "morloc_vec_fold" as fold
    , "morloc_vec_fold1" as fold1
    , "morloc_vec_safeFold1" as safeFold1
    )

instance Eq (Vector n a) where
  %inline source R from "R/vector.R" ("morloc_vec_eq" as (==))

instance Ord (Vector n a) where
  %inline source R from "R/vector.R" ("morloc_vec_le" as (<=))

-- Vector packs as an R @list@ on the wire; the per-language form is
-- an R atomic vector (numeric / integer / logical / ...).
-- @Packable a b@: pack is wire->native (list -> atomic), unpack is
-- native->wire (atomic -> list).
instance Packable (List a) (Vector n a) where
  source R from "R/vector.R"
   ( "morloc_unpackVector" as pack    -- list -> atomic
   , "morloc_packVector"   as unpack  -- atomic -> list
  )
